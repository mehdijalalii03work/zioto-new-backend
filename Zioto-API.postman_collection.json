              "raw": "{\n  \"label\": \"Home\",\n  \"province_id\": 1,\n  \"city_id\": 1,\n  \"district\": \"District 1\",\n  \"postal_code\": \"1234567890\",\n  \"address_line\": \"123 Main Street, Building 5\",\n  \"plate\": \"12\",\n  \"unit\": \"3\",\n  \"receiver_name\": \"Ali Rezaei\",\n  \"receiver_phone\": \"09123456789\",\n  \"latitude\": 35.6892,\n  \"longitude\": 51.3890,\n  \"is_default\": true,\n  \"is_billing\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/addresses",
              "host": ["{{baseUrl}}"],
              "path": ["addresses"]
