              "mode": "raw",
              "raw": "{\n  \"phone\": \"09987654321\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/profile/change-phone/send-otp",
              "host": ["{{baseUrl}}"],
              "path": ["profile", "change-phone", "send-otp"]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "description": "Send OTP to change phone number.\n\nRequires authentication. Rate limited by `throttle:otp`.\n\n**Request body:**\n- `phone` (required): 11-digit mobile number\n\n**Response 200:** `{ \"message\": \"...\", \"token\": \"change-phone-token\" }`"
          }
        },
        {
          "name": "Change Phone - Verify",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"from-send-otp\",\n  \"code\": \"12345\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/profile/change-phone/verify",
              "host": ["{{baseUrl}}"],
              "path": ["profile", "change-phone", "verify"]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "description": "Verify OTP and change phone number (includes Shahkar verification).\n\nRequires authentication. Rate limited: `throttle:shahkar`.\n\n**Request body:**\n- `token` (required): Token from send-otp response\n- `code` (required): 5-digit OTP code"
          }
        }
      ]
    },
